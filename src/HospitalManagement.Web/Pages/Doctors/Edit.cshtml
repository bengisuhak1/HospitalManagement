@page "{id:guid}"
@model HospitalManagement.Web.Pages.Doctors.EditModel

@{
    ViewData["Title"] = "Doktor Düzenle";
}

<div class="container mt-4">
    <div class="card">
        <div class="card-header">
            <h2 class="mb-0">Doktor Düzenle</h2>
        </div>

        <div class="card-body">
            <form method="post">
                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Doctor.FirstName"
                           class="form-label">Ad</label>
                    <input asp-for="Doctor.FirstName"
                           class="form-control" />
                    <span asp-validation-for="Doctor.FirstName"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Doctor.LastName"
                           class="form-label">Soyad</label>
                    <input asp-for="Doctor.LastName"
                           class="form-control" />
                    <span asp-validation-for="Doctor.LastName"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Doctor.Specialty"
                           class="form-label">Branş</label>
                    <input asp-for="Doctor.Specialty"
                           class="form-control" />
                    <span asp-validation-for="Doctor.Specialty"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Doctor.PhoneNumber"
                           class="form-label">Telefon Numarası</label>
                    <input asp-for="Doctor.PhoneNumber"
                           class="form-control" />
                    <span asp-validation-for="Doctor.PhoneNumber"
                          class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary">
                    Değişiklikleri Kaydet
                </button>

                <a asp-page="./Index"
                   class="btn btn-outline-secondary">
                    İptal
                </a>
            </form>
        </div>
    </div>
</div>