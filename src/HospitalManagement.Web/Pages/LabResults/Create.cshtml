@page
@model HospitalManagement.Web.Pages.LabResults.CreateModel

@{
    ViewData["Title"] = "Yeni Tahlil Sonucu";
}

<div class="container mt-4">
    <div class="card">
        <div class="card-header"><h2 class="mb-0">Yeni Tahlil Sonucu</h2></div>
        <div class="card-body">
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="LabResult.PatientId" class="form-label">Hasta</label>
                    <select asp-for="LabResult.PatientId" asp-items="Model.PatientOptions" class="form-select">
                        <option value="">Hasta seçiniz</option>
                    </select>
                    <span asp-validation-for="LabResult.PatientId" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="LabResult.TestName" class="form-label">Tahlil Adı</label>
                        <input asp-for="LabResult.TestName" class="form-control" placeholder="Örn. Hemoglobin" />
                        <span asp-validation-for="LabResult.TestName" class="text-danger"></span>
                    </div>
                    <div class="col-md-3 mb-3">
                        <label asp-for="LabResult.ResultValue" class="form-label">Sonuç</label>
                        <input asp-for="LabResult.ResultValue" class="form-control" />
                        <span asp-validation-for="LabResult.ResultValue" class="text-danger"></span>
                    </div>
                    <div class="col-md-3 mb-3">
                        <label asp-for="LabResult.Unit" class="form-label">Birim</label>
                        <input asp-for="LabResult.Unit" class="form-control" placeholder="Örn. g/dL" />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="LabResult.ReferenceRange" class="form-label">Referans Aralığı</label>
                        <input asp-for="LabResult.ReferenceRange" class="form-control" placeholder="Örn. 12-16" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="LabResult.Status" class="form-label">Durum</label>
                        <select asp-for="LabResult.Status" class="form-select">
                            <option value="Normal">Normal</option>
                            <option value="Yüksek">Yüksek</option>
                            <option value="Düşük">Düşük</option>
                        </select>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="LabResult.ResultDate" class="form-label">Sonuç Tarihi</label>
                        <input asp-for="LabResult.ResultDate" type="datetime-local" class="form-control" />
                    </div>
                </div>

                <button type="submit" class="btn btn-primary">Kaydet</button>
                <a asp-page="./Index" class="btn btn-outline-secondary">İptal</a>
            </form>
        </div>
    </div>
</div>
