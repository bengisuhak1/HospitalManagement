@page
@model HospitalManagement.Web.Pages.Patients.CreateModel

@{
    ViewData["Title"] = "Yeni Hasta Ekle";
}

<div class="container mt-4">

    <div class="card">
        <div class="card-header">
            <h3>Yeni Hasta Ekle</h3>
        </div>

        <div class="card-body">

            <form method="post">

                <div class="mb-3">
                    <label asp-for="Patient.IdentityNumber" class="form-label">
                        T.C. Kimlik Numarası
                    </label>

                    <input asp-for="Patient.IdentityNumber"
                           class="form-control" />

                    <span asp-validation-for="Patient.IdentityNumber"
                          class="text-danger">
                    </span>
                </div>

                <div class="mb-3">
                    <label asp-for="Patient.FirstName" class="form-label">
                        Ad
                    </label>

                    <input asp-for="Patient.FirstName"
                           class="form-control" />

                    <span asp-validation-for="Patient.FirstName"
                          class="text-danger">
                    </span>
                </div>

                <div class="mb-3">
                    <label asp-for="Patient.LastName" class="form-label">
                        Soyad
                    </label>

                    <input asp-for="Patient.LastName"
                           class="form-control" />

                    <span asp-validation-for="Patient.LastName"
                          class="text-danger">
                    </span>
                </div>

                <div class="mb-3">
                    <label asp-for="Patient.BirthDate" class="form-label">
                        Doğum Tarihi
                    </label>

                    <input asp-for="Patient.BirthDate"
                           type="date"
                           class="form-control" />

                    <span asp-validation-for="Patient.BirthDate"
                          class="text-danger">
                    </span>
                </div>

                <div class="mb-3">
                    <label asp-for="Patient.PhoneNumber" class="form-label">
                        Telefon Numarası
                    </label>

                    <input asp-for="Patient.PhoneNumber"
                           class="form-control" />

                    <span asp-validation-for="Patient.PhoneNumber"
                          class="text-danger">
                    </span>
                </div>

                <button type="submit" class="btn btn-primary">
                    Kaydet
                </button>

                <a asp-page="./Index" class="btn btn-secondary">
                    İptal
                </a>

            </form>

        </div>
    </div>
</div>