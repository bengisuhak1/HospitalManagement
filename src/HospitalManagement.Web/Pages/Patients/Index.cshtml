@page
@model HospitalManagement.Web.Pages.Patients.IndexModel

@{
    ViewData["Title"] = "Hasta Yönetimi";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Hasta Yönetimi</h2>
<a asp-page="./Create" class="btn btn-primary">
    Yeni Hasta Ekle
</a>
    </div>

    <div class="card">
        <div class="card-body">

            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>T.C. Kimlik Numarası</th>
                        <th>Ad</th>
                        <th>Soyad</th>
                        <th>Doğum Tarihi</th>
                        <th>Telefon Numarası</th>
                        <th>İşlemler</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var patient in Model.Patients)
                    {
                        <tr>
                            <td>@patient.IdentityNumber</td>
                            <td>@patient.FirstName</td>
                            <td>@patient.LastName</td>
                            <td>@patient.BirthDate.ToString("dd.MM.yyyy")</td>
                            <td>@patient.PhoneNumber</td>

                            <td>
                                <a asp-page="./Edit" asp-route-id="@patient.Id"
   class="btn btn-sm btn-warning">
    Düzenle
</a>
<form method="post"
      asp-page-handler="Delete"
      asp-route-id="@patient.Id"
      style="display:inline;"
      onsubmit="return confirm('Bu hastayı silmek istediğinize emin misiniz?');">
                               
    <button type="submit" class="btn btn-sm btn-danger">
        Sil
    </button>
</form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            @if (Model.Patients.Count == 0)
            {
                <div class="alert alert-info">
                    Henüz kayıtlı hasta bulunmuyor.
                </div>
            }

        </div>
    </div>
</div>