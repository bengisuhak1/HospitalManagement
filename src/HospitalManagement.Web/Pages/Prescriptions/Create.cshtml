@page
@model HospitalManagement.Web.Pages.Prescriptions.CreateModel

@{
    ViewData["Title"] = "Yeni Reçete";
}

<div class="container mt-4">
    <div class="card">
        <div class="card-header"><h2 class="mb-0">Yeni Reçete</h2></div>
        <div class="card-body">
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Prescription.PatientId" class="form-label">Hasta</label>
                        <select asp-for="Prescription.PatientId" asp-items="Model.PatientOptions" class="form-select">
                            <option value="">Hasta seçiniz</option>
                        </select>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Prescription.DoctorId" class="form-label">Doktor</label>
                        <select asp-for="Prescription.DoctorId" asp-items="Model.DoctorOptions" class="form-select">
                            <option value="">Doktor seçiniz</option>
                        </select>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Prescription.MedicationName" class="form-label">İlaç Adı</label>
                    <input asp-for="Prescription.MedicationName" class="form-control" placeholder="Örn. Paracetamol" />
                </div>

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="Prescription.Dosage" class="form-label">Doz</label>
                        <input asp-for="Prescription.Dosage" class="form-control" placeholder="Örn. 500 mg" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="Prescription.Frequency" class="form-label">Kullanım Sıklığı</label>
                        <input asp-for="Prescription.Frequency" class="form-control" placeholder="Örn. Günde 2 kez" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="Prescription.Duration" class="form-label">Süre</label>
                        <input asp-for="Prescription.Duration" class="form-control" placeholder="Örn. 5 gün" />
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Prescription.Instructions" class="form-label">Kullanım Açıklaması</label>
                    <textarea asp-for="Prescription.Instructions" class="form-control" rows="3" placeholder="Örn. Tok karnına kullanınız."></textarea>
                </div>

                <div class="mb-3">
                    <label asp-for="Prescription.PrescriptionDate" class="form-label">Reçete Tarihi</label>
                    <input asp-for="Prescription.PrescriptionDate" type="datetime-local" class="form-control" />
                </div>

                <button type="submit" class="btn btn-primary">Reçeteyi Kaydet</button>
                <a asp-page="./Index" class="btn btn-outline-secondary">İptal</a>
            </form>
        </div>
    </div>
</div>
